# Environment Configuration
# Copy this file to .env (default), .env.local, and .env.production
# The build system will use the appropriate file based on the npm script

# Supabase Configuration
# Get these values from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# API Configuration
# Local: http://YOUR_LOCAL_IP:3000 (e.g., http://192.168.1.5:3000)
# Production: https://your-app.vercel.app
API_URL=https://your-app.vercel.app

# Mapbox
MAPBOX_ACCESS_TOKEN=your-mapbox-public-token
