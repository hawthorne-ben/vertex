/*
 * BLE Server - Bluetooth Low Energy Interface
 *
 * Handles BLE advertising, connections, and characteristic notifications
 */

#ifndef BLE_SERVER_H
#define BLE_SERVER_H

#include <Arduino.h>

// BLE connection state
enum BLEState {
  BLE_IDLE,
  BLE_ADVERTISING,
  BLE_CONNECTED
};

// Function prototypes
bool initBLE();
void updateBLE();
bool isClientConnected();
BLEState getBLEState();
void sendSensorData();
void sendBatteryLevel(uint8_t level);
void sendCalibrationStatus();

// Event callbacks
void onConnect();
void onDisconnect();

#endif // BLE_SERVER_H
