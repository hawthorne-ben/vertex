{
  "name": "vertex-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Vertex IMU cycling data analysis platform - Monorepo",
  "homepage": "https://ridevertex.com",
  "workspaces": [
    "packages/*",
    "web",
    "android"
  ],
  "scripts": {
    "version:vtx-format": "lerna version --scope @vertex/vtx-format",
    "version:vtx-constants": "lerna version --scope @vertex/vtx-constants",
    "version:firmware": "./scripts/version.sh firmware",
    "version:android": "lerna version --scope vertex-android",
    "version:web": "lerna version --scope vertex-web",
    "publish:packages": "lerna publish from-package",
    "dev:web": "cd web && npm run dev",
    "dev:android": "cd android && npm run android",
    "build:web": "cd web && npm run build",
    "build:android:debug": "cd android && ./android/gradlew assembleDebug -p android",
    "build:android:release": "cd android && ./android/gradlew assembleRelease -p android",
    "build:android": "npm run build:android:debug"
  },
  "devDependencies": {
    "lerna": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
