{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vertex.com/schemas/vtx-v1.json",
  "title": "VTX Metadata Schema v1.0",
  "description": "JSON schema for VTX file metadata section",
  "type": "object",
  "properties": {
    "device": {
      "type": "object",
      "description": "Device information",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique device identifier"
        },
        "name": {
          "type": "string",
          "description": "Human-readable device name"
        },
        "firmware_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Firmware version (semver)"
        },
        "hardware_revision": {
          "type": "string",
          "description": "Hardware revision identifier"
        }
      },
      "required": ["id", "name"]
    },
    "session": {
      "type": "object",
      "description": "Recording session information",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of session creation"
        },
        "created_by": {
          "type": "string",
          "description": "User email or identifier"
        },
        "bike": {
          "type": "string",
          "description": "Bike identifier"
        },
        "position": {
          "type": "string",
          "enum": ["Body", "Seatpost", "Other"],
          "description": "Sensor mounting position"
        },
        "notes": {
          "type": "string",
          "description": "User notes about the session"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Session tags for categorization"
        }
      },
      "required": ["created_at"]
    },
    "calibration": {
      "type": "object",
      "description": "Calibration information",
      "properties": {
        "zero_point": {
          "type": "object",
          "description": "Zero point calibration values",
          "properties": {
            "roll": { "type": "number" },
            "pitch": { "type": "number" },
            "yaw": { "type": "number" },
            "accel_x": { "type": "number" },
            "accel_y": { "type": "number" },
            "accel_z": { "type": "number" },
            "gyro_x": { "type": "number" },
            "gyro_y": { "type": "number" },
            "gyro_z": { "type": "number" },
            "mag_x": { "type": "number" },
            "mag_y": { "type": "number" },
            "mag_z": { "type": "number" }
          }
        },
        "applied": {
          "type": "boolean",
          "description": "Whether calibration was applied to data"
        }
      },
      "required": ["applied"]
    },
    "custom": {
      "type": "object",
      "description": "User-defined custom fields",
      "additionalProperties": true
    }
  }
}
