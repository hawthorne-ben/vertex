{
  "name": "@vertex-pkg/vtx-parser",
  "version": "0.4.1",
  "description": "TypeScript and Python encoder/decoder for VTX binary format",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "npm run test:ts && npm run test:py",
    "test:ts": "jest",
    "test:py": "cd python && python -m pytest",
    "test:py:coverage": "cd python && python -m pytest --cov=vtx_parser --cov-report=html",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vtx",
    "vertex",
    "imu",
    "binary-format",
    "parser",
    "encoder",
    "decoder",
    "python",
    "typescript"
  ],
  "author": "Vertex Team",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist/",
    "src/",
    "python/vtx_parser/",
    "python/tests/",
    "python/setup.py",
    "python/pytest.ini",
    "python/README.md",
    "python/.gitignore",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/vertex.git",
    "directory": "packages/vtx-parser"
  }
}
